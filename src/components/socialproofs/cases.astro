---
import Logos from "@components/socialproofs/customerLogos";
import { painPointCategories } from "@components/socialproofs/cases-content";
import { urlFor } from "../../sanity/image";

interface CaseStudy {
  slug: string;
  data: {
    logo: string | unknown;
    logoAlt: string;
    painPointCategory: string;
    title: string;
    tags: string[];
    challenge: string;
    approach: string;
    action: string;
    results: string;
  };
}

interface Props {
  caseStudies: CaseStudy[];
  seeMoreHref?: string;
  seeMoreLabel?: string;
}

const props = Astro.props as Partial<Props> | undefined;
const caseStudies = props?.caseStudies ?? [];
const seeMoreHref = props?.seeMoreHref;
const seeMoreLabel = props?.seeMoreLabel ?? "See more proof of work";

const getImageSrc = (logo: string | unknown) => {
  if (typeof logo === "string") return logo;
  return urlFor(logo).width(240).url();
};
---

<section id="cases" class=" dark:from-theme-moon-bg dark:to-theme-moon-bgAccent py-24">
  <div class="md:w-3/4 lg:w-2/3 mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl text-center">
    <div class="inline-flex items-center justify-center p-2 bg-theme-sun-accent/10 dark:bg-theme-moon-accent/20 rounded-full mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="w-6 h-6 text-theme-sun-accent dark:text-theme-moon-accent" viewBox="0 0 24 24">
        <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813A3.75 3.75 0 007.466 7.89l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-theme-sun-text dark:text-theme-moon-text md:text-4xl lg:text-4xl mb-4">
      Let's talk outcomes
    </h3>
    <p class="text-lg text-theme-sun-textMuted dark:text-theme-moon-textMuted max-w-2xl mx-auto mb-8">
      Solutions to common challenges in product adoption, visibility, and conversion
    </p>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {painPointCategories.map((category) => (
        <div class="bg-white dark:bg-theme-moon-bgAccent rounded-xl p-6 border border-theme-sun-border/10 dark:border-theme-moon-border/10 text-center transition-all hover:border-theme-sun-accent/30 dark:hover:border-theme-moon-accent/30">
          <h3 class="text-lg font-semibold text-theme-sun-text dark:text-theme-moon-text mb-2">{category.label}</h3>
          <p class="text-sm text-theme-sun-textMuted dark:text-theme-moon-textMuted">{category.description}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 grid-cols-1 lg:grid-cols-2">
      {
        caseStudies.map((study) => (
          <div class="group bg-white dark:bg-theme-moon-bgAccent border border-theme-sun-border/20 dark:border-theme-moon-border/20 rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300">
            <div class="relative pt-6 pl-2 pr-6 border-b border-theme-sun-border/10 dark:border-theme-moon-border/10 flex items-center justify-between">
              <div class="flex items-center gap-4">
                <img src={getImageSrc(study.data.logo)} alt={study.data.logoAlt} loading="lazy" decoding="async" class="w-17 theme-logo" />
              </div>

              <span class="text-center p-2  bg-theme-sun-accent/10 dark:bg-theme-moon-accent/20 text-theme-sun-accent dark:text-theme-moon-accent rounded-full text-xs font-medium">
                {painPointCategories.find((c) => c.id === study.data.painPointCategory)?.label}
              </span>
            </div>
            <div>
              <h4 class="pl-6 px-3 py-1  text-lg font-bold text-theme-sun-textMuted dark:text-theme-moon-text group-hover:text-theme-sun-accent dark:group-hover:text-theme-moon-accent transition-colors">
                {study.data.title}
              </h4>
            </div>

            <div class="p-6">
              <div class="flex flex-wrap gap-2 mb-6">
                {
                  study.data.tags.map((tag) => (
                    <span class="bg-theme-sun-bgAccent/50 dark:bg-theme-moon-bg/70 px-2.5 py-1 rounded-md text-xs text-theme-sun-secondary dark:text-theme-moon-secondary font-medium">{tag}</span>
                  ))
                }
              </div>

              <div class="space-y-6">
                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center text-red-600 dark:text-red-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-semibold text-theme-sun-text dark:text-theme-moon-text mb-1">Challenge</h4>
                    <p class="text-sm text-theme-sun-textMuted dark:text-theme-moon-textMuted">{study.data.challenge}</p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-semibold text-theme-sun-text dark:text-theme-moon-text mb-1">Approach</h4>
                    <p class="text-sm text-theme-sun-textMuted dark:text-theme-moon-textMuted">{study.data.approach}</p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-semibold text-theme-sun-text dark:text-theme-moon-text mb-1">Action</h4>
                    <p class="text-sm text-theme-sun-textMuted dark:text-theme-moon-textMuted">{study.data.action}</p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-green-600 dark:text-green-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-semibold text-theme-sun-text dark:text-theme-moon-text mb-1">Results</h4>
                    <p class="text-sm text-theme-sun-textMuted dark:text-theme-moon-textMuted">{study.data.results}</p>
                  </div>
                </div>
              </div>

              <div class="mt-8 pt-5 border-t border-theme-sun-border/10 dark:border-theme-moon-border/10">
                <a href={`/cases/${study.slug}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-theme-sun-accent dark:text-theme-moon-accent hover:underline">
                  Read full case study
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  {seeMoreHref && (
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mt-12 text-center">
      <a
        href={seeMoreHref}
        class="inline-flex items-center gap-2 rounded-full px-5 py-2 text-sm font-medium border border-theme-sun-border/20 dark:border-theme-moon-border/20 text-theme-sun-secondary dark:text-theme-moon-secondary hover:text-theme-sun-accent dark:hover:text-theme-moon-accent hover:border-theme-sun-accent/30 dark:hover:border-theme-moon-accent/30 transition"
      >
        {seeMoreLabel}
      </a>
    </div>
  )}

  <Logos />
</section>
