<section>
  <div class="px-8 md:px-12 py-12 mx-auto">
    <div
      class="h-full bg-theme-sun-secondary dark:bg-theme-moon-bgAccent rounded-3xl text-center overflow-hidden p-8"
    >
      <h2
        class="text-5xl pt-4 pb-10 tracking-tighter font-normal md:text-4xl text-white"
      >
        Your product deserves traction. <span class="md:block text-zinc-300"
          >Let’s make it happen.</span
        >
      </h2>

      <!-- Cal inline embed code begins -->
      <div
        style="width:100%;height:100%;overflow:scroll"
        id="my-cal-inline-chat"
      >
      </div>
      <script type="text/javascript">
        (function (C, A, L) {
          let p = function (a, ar) {
            a.q.push(ar);
          };
          let d = C.document;
          C.Cal =
            C.Cal ||
            function () {
              let cal = C.Cal;
              let ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                d.head.appendChild(d.createElement("script")).src = A;
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () {
                  p(api, arguments);
                };
                const namespace = ar[1];
                api.q = api.q || [];
                if (typeof namespace === "string") {
                  cal.ns[namespace] = cal.ns[namespace] || api;
                  p(cal.ns[namespace], ar);
                  p(cal, ["initNamespace", namespace]);
                } else p(cal, ar);
                return;
              }
              p(cal, ar);
            };
        })(window, "https://app.cal.com/embed/embed.js", "init");
        Cal("init", "chat", { origin: "https://app.cal.com" });

        Cal.ns.chat("inline", {
          elementOrSelector: "#my-cal-inline-chat",
          config: { layout: "month_view" },
          calLink: "rabia-ahmed/chat",
        });

        Cal.ns.chat("ui", {
          hideEventTypeDetails: false,
          layout: "month_view",
        });
      </script>
      <!-- Cal inline embed code ends -->
    </div>
  </div>
</section>
