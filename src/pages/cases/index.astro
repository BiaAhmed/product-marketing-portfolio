---
import { getCollection } from "astro:content";
import { BaseHead } from "@components/seo";
import Layout from "@layouts/layout.astro";
import CaseStudies from "@components/socialproofs/cases.astro";
import { getClient } from "../../sanity/client";
import { allCaseStudiesQuery, type SanityCaseStudy } from "../../sanity/queries";

const sanityClient = getClient();
const sanityCases = await sanityClient.fetch<SanityCaseStudy[]>(allCaseStudiesQuery).catch(() => []);
const legacyCases = await getCollection("cases");

const mapCategory = (category?: string) => {
  if (category === "User Adoption") return "adoption";
  if (category === "Discoverability") return "discoverability";
  if (category === "Developer Experience") return "documentation";
  if (category === "Conversion") return "conversion";
  return "adoption";
};

const normalizedSanityCases = sanityCases.map((study) => ({
  slug: study.slug?.current,
  data: {
    logo: study.companyLogo,
    logoAlt: study.company || study.title,
    painPointCategory: mapCategory(study.category),
    title: study.title,
    tags: study.tags ?? [],
    challenge: study.challenge,
    approach: study.approach,
    action: study.action,
    results: study.results,
    pubDate: new Date(),
    order: study.order ?? Number.MAX_SAFE_INTEGER,
  },
}));

const normalizedLegacyCases = legacyCases.map((study) => ({
  slug: study.slug,
  data: {
    logo: study.data.logo,
    logoAlt: study.data.logoAlt,
    painPointCategory: study.data.painPointCategory,
    title: study.data.title,
    tags: study.data.tags,
    challenge: study.data.challenge,
    approach: study.data.approach,
    action: study.data.action,
    results: study.data.results,
    pubDate: study.data.pubDate,
    order: Number.MAX_SAFE_INTEGER,
  },
}));

const merged = [...normalizedSanityCases, ...normalizedLegacyCases].filter((study) => study.slug);
const deduped = Array.from(new Map(merged.map((study) => [study.slug, study])).values());
const caseStudies = deduped.sort((a, b) => a.data.order - b.data.order || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<head>
    <BaseHead
        title="Case Studies – Rabia Ahmed"
        description="Impact stories in adoption, visibility, and conversion — each with a dedicated breakdown."
        image="/images/ogimage.png"
    />
</head>

<Layout>
    <section class="relative min-h-screen pt-32 sm:pt-40 pb-24 overflow-hidden">
        <div
            aria-hidden
            class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/3 w-[1000px] h-[800px]
                opacity-0 dark:opacity-35
                [background-image:radial-gradient(theme(colors.gray.500),transparent_50%)]"
        >
        </div>

        <div
            class="relative z-10 max-w-3xl lg:max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-neutral dark:prose-invert"
        >
            <h1
                class="mb-2 font-semibold tracking-tight text-4xl sm:text-5xl text-gray-900 dark:text-white text-center"
            >
                I help SaaS teams fix the gaps between product and growth.
            </h1>
            <p
                class="text-lg text-center text-theme-sun-textMuted dark:text-theme-moon-textMuted max-w-3xl mx-auto"
            >
                Below are short stories of where I’ve tightened positioning, funnels, and analytics so signups, activation,
                and pipeline started to move.
            </p>
        </div>
        <CaseStudies caseStudies={caseStudies} />
    </section>
</Layout>
