---
import { getCollection } from "astro:content";
import { BaseHead } from "@components/seo";
import Layout from "@layouts/layout.astro";
import CaseStudies from "@components/socialproofs/cases.astro";

const caseStudies = (await getCollection("cases")).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<head>
    <BaseHead
        title="Case Studies – Rabia Ahmed"
        description="Impact stories in adoption, visibility, and conversion — each with a dedicated breakdown."
        image="/images/ogimage.png"
    />
</head>

<Layout>
    <section class="relative min-h-screen pt-32 sm:pt-40 pb-24 overflow-hidden">
        <!-- radial flare -->
        <div
            aria-hidden
            class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/3 w-[1000px] h-[800px]
                opacity-0 dark:opacity-35
                [background-image:radial-gradient(theme(colors.gray.500),transparent_50%)]"
        >
        </div>

        <div
            class="relative z-10 max-w-3xl lg:max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-neutral dark:prose-invert"
        >
            <h1
                class="mb-2 font-semibold tracking-tight text-4xl sm:text-5xl text-gray-900 dark:text-white text-center"
            >
                I'm Rabia, I like to play where form and function intersect.
            </h1>
        </div>
        <CaseStudies caseStudies={caseStudies} />
    </section>
</Layout>
