---
import { getCollection } from "astro:content";
import { ScrollProgress } from "@components/misc";
import PortableText from "@components/PortableText.astro";
import ResourcesLayout from "@layouts/resources-layout.astro";
import { getReadingTime } from "@utils/index";
import { getClient } from "../../sanity/client";
import { allResourcesQuery, type SanityResource } from "../../sanity/queries";

const posts = await getCollection("resource");
const { slug } = Astro.params;
const sanityClient = getClient();
const sanityResources = await sanityClient.fetch<SanityResource[]>(allResourcesQuery).catch(() => []);
const sanityPost = sanityResources.find((resource) => resource.slug?.current === slug);
const legacyPost = posts.find((page) => page.slug === slug);

if (!sanityPost && !legacyPost) return Astro.redirect("/404");

const title = sanityPost?.title ?? legacyPost?.data.title;
const description = sanityPost?.description ?? legacyPost?.data.description;
const showTldr = legacyPost?.data.showTldr ?? true;
const pubDate = sanityPost?.publishedAt ? new Date(sanityPost.publishedAt) : legacyPost?.data.pubDate;

const readingSource = sanityPost?.body ? JSON.stringify(sanityPost.body) : legacyPost?.body ?? "";
const readingTime = getReadingTime(readingSource);
const renderedLegacy = legacyPost ? await legacyPost.render() : null;
const LegacyContent = renderedLegacy?.Content;
---

<ResourcesLayout title={title} description={description} showTldr={showTldr} pubDate={pubDate} readingTime={readingTime}>
  {sanityPost?.body ? <PortableText value={sanityPost.body} /> : LegacyContent && <LegacyContent />}
	<ScrollProgress />
</ResourcesLayout>
