---
import { getCollection } from "astro:content";
import { ResourcesItem } from "@components/cards";
import { BaseHead } from "@components/seo";
import { SITE_DESCRIPTION, SITE_TITLE } from "@data/index";
import Layout from "@layouts/layout.astro";
import { getClient } from "../../sanity/client";
import { allResourcesQuery, type SanityResource } from "../../sanity/queries";

const PAGE_SIZE = 6;
const sanityClient = getClient();
const sanityResources = await sanityClient.fetch<SanityResource[]>(allResourcesQuery).catch(() => []);
const legacyResources = await getCollection("resource");

const normalizedSanityResources = sanityResources.map((resource) => ({
  slug: resource.slug?.current,
  data: {
    category: resource.resourceType,
    description: resource.description,
    pubDate: resource.publishedAt ? new Date(resource.publishedAt) : new Date(),
  },
}));

const normalizedLegacyResources = legacyResources.map((resource) => ({
  slug: resource.slug,
  data: {
    category: resource.data.category,
    description: resource.data.description,
    pubDate: resource.data.pubDate,
  },
}));

const merged = [...normalizedSanityResources, ...normalizedLegacyResources].filter((resource) => resource.slug);
const deduped = Array.from(new Map(merged.map((resource) => [resource.slug, resource])).values());
const allResources = deduped.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const start = (currentPage - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;
const resources = allResources.slice(start, end);
const totalPages = Math.ceil(allResources.length / PAGE_SIZE);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Resources — ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
      image="/images/ogimage.png"
    />
  </head>
  <Layout>
    <section class="px-6 pt-24 pb-16 max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl pt-11 font-bold tracking-tight text-theme-sun-text dark:text-theme-moon-text mb-12">
        Resources by Rabia Ahmed
      </h1>

      <div class="space-y-12">
        {
          resources.map((resource, i) => (
            <ResourcesItem
              category={resource.data.category}
              content={resource.data.description}
              pubDate={resource.data.pubDate}
              slug={resource.slug}
              index={i}
            />
          ))
        }
      </div>

      <nav class="mt-16 flex justify-center gap-4">
        {
          currentPage > 1 && (
            <a href={`?page=${currentPage - 1}`} class="px-4 py-2 rounded bg-theme-sun-primary text-black dark:text-theme-moon-text font-medium">
              ← Previous
            </a>
          )
        }
        {
          currentPage < totalPages && (
            <a href={`?page=${currentPage + 1}`} class="px-4 py-2 rounded bg-theme-sun-primary text-black dark:text-theme-moon-text font-medium">
              Next →
            </a>
          )
        }
      </nav>
    </section>
  </Layout>
</html>
