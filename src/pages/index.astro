---
import { getCollection } from "astro:content";
import Cta from "@components/cta/home-cta.astro";
import Faq from "@components/misc/faq";
import Hero from "@components/misc/hero.astro";
import { BaseHead } from "@components/seo";
import Cases from "@components/socialproofs/cases.astro";
import Showcase from "@components/socialproofs/showcase.astro";
import Stack from "@components/socialproofs/stack.astro";
import TestimonialsMarquee from "@components/socialproofs/testimonials-marquee";
import { SITE_TITLE } from "@data/index";
import { SITE_DESCRIPTION } from "@data/index";
import Layout from "../layouts/layout.astro";

const caseStudies = (await getCollection("cases")).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredCaseStudies = caseStudies.slice(0, 4);
---

<!doctype html>
<html lang='en' >
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			image='/images/ogimage.png'
		/>
	</head>
	
	<Layout>
		<div>
			<Hero/>
			<Showcase/>
                        <Cases
                                caseStudies={featuredCaseStudies}
                                seeMoreHref="/cases"
                                seeMoreLabel="See more proof of work"
                        />
			<Stack/>
			<Faq client:visible/>
                        <TestimonialsMarquee client:visible/>
                        <Cta/>
			</div>
		</div>
	
	</Layout>
</html>
